{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "💣 Reset Zombie Tavern",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\reset-project.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "🔍 Check Git Changes",
            "type": "shell",
            "command": "git",
            "args": [
                "status",
                "--short"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}